rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 衛生用品＆備蓄 在庫管理アプリ：全デバイス（スマホ・PC）間リアルタイム共有ルール
    match /products/{productId} {
      allow read, write: if true;
    }
    match /stockpiles/{stockpileId} {
      allow read, write: if true;
    }
    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }
    match /staffWithdrawals/{staffWithdrawalId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /staff/{staffId} {
      allow read, write: if true;
    }
    match /metadata/{docId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
